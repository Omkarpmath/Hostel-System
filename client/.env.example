# Razorpay's public test key only. The secret must remain in server/.env.

# URL encoded in student QR codes. For a phone on the same Wi-Fi while running
# locally, replace this with your Mac's current LAN IP, e.g.
# VITE_PUBLIC_APP_URL=http://192.168.1.25:5173
# For a deployed app, use its HTTPS URL instead.
VITE_PUBLIC_APP_URL=

# Set this in the Render Static Site's build environment. Leave it unset for
# local development so Vite's /api proxy remains in use.
VITE_API_URL=
